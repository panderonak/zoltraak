{
	"name": "zoltraak",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@types/react": "^19.2.10",
			"@types/react-dom": "^19.2.3",
			"better-auth": "1.5.2",
			"dotenv": "^17.3.1",
			"lucide-react": "^0.546.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.3",
			"react-dom": "^19.2.3",
			"sonner": "^2.0.5",
			"tailwindcss": "^4.1.18",
			"zod": "^4.3.6"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @zoltraak/db db:push",
		"db:studio": "turbo -F @zoltraak/db db:studio",
		"db:generate": "turbo -F @zoltraak/db db:generate",
		"db:migrate": "turbo -F @zoltraak/db db:migrate",
		"auth:generate": "turbo -F @zoltraak/auth auth:generate",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@zoltraak/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^22.19.18",
		"@zoltraak/config": "workspace:*",
		"turbo": "^2.9.12",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@11.2.2"
}
