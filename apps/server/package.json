		"@zoltraak/env": "workspace:*",
		"better-auth": "catalog:",
		"cors": "^2.8.5",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"express": "^5.1.0",
		"razorpay": "^2.9.6",
		"uuid": "^13.0.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.1",
		"@types/node": "^22.13.14",
